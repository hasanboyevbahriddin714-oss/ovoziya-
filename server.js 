
const express = require("express");
const cors = require("cors");

const app = express();

app.use(cors());
app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    message: "Ovoziya backend ishlayapti!",
    status: "success"
  });
});

app.get("/api/books", (req, res) => {
  res.json([]);
});

app.post("/api/partners", (req, res) => {
  res.json({
    message: "Hamkorlik arizasi qabul qilindi"
  });
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, () => {
  console.log("Ovoziya server ishlayapti!");
});
