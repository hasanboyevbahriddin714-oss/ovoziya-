        .book-title { font-weight: bold; font-size: 16px; }
        .listen-btn { background: #28a745; color: white; padding: 5px 12px; border-radius: 4px; text-decoration: none; font-size: 14px; }
        .listen-btn:hover { background: #218838; }
    </style>
